# Copy to .env for local runs. On Replit, put these in Secrets instead.

# Database. Leave unset locally to use SQLite at data/app.db.
# On Replit, adding a PostgreSQL database sets DATABASE_URL for you.
# DATABASE_URL=postgresql://user:pass@host/db

# Protects POST /api/admin/refresh. Pick any long random string.
ADMIN_TOKEN=change-me

# Language model on a RunPod Serverless GPU endpoint (RunPod's vLLM worker). When both are
# set they win over LLM_API_KEY below. See runpod/README.md.
# RUNPOD_API_KEY=
# RUNPOD_ENDPOINT_ID=
# RUNPOD_MODEL=Qwen/Qwen2.5-7B-Instruct

# Language model through an OpenAI-compatible API. When LLM_API_KEY is set it is used
# instead of the CodeBuddy CLI below. Defaults are DeepSeek (platform.deepseek.com).
# LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# WorkBuddy (CodeBuddy) CLI connection for skill extraction and explanations.
# Locally the CLI reuses your interactive login. On Replit, set an API key.
LLM_ENABLED=1
CODEBUDDY_BIN=codebuddy
CODEBUDDY_MODEL=deepseek-v4.1-flash
# CODEBUDDY_API_KEY=
# International edition: leave CODEBUDDY_INTERNET_ENVIRONMENT unset.

# Optional job-postings source (Singapore market as a regional proxy).
# ADZUNA_APP_ID=
# ADZUNA_APP_KEY=

# Tester accounts created at start-up ("id:Display name", comma separated).
# New testers see the About you setup the first time they sign in.
# TEST_ACCOUNTS=alice:Alice,bob:Bob
